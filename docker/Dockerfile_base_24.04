FROM ubuntu:24.04
ARG NODE
ENV DEBIAN_FRONTEND=noninteractive

RUN userdel -r ubuntu \
  && groupadd --gid 1000 node \
  && useradd --uid 1000 --gid node --shell /bin/bash --create-home node

RUN groupadd -r docker -g 991 \
  && groupadd -r i2c -g 990 \
  && groupadd -r spi -g 989 \
  && apt-get update \
  && apt-get -y install --no-install-recommends git \
  python3 python3-venv python3-pip build-essential \
  sysstat procps nano curl libcap2-bin sudo bluez tini gpiod \
  && usermod -a -G dialout,i2c,spi,docker node \
  # set-system-time probes with `sudo -n date`, then runs
  # `sudo date -u -s "YYYY-MM-DD HH:MM:SS"`. The argument is pinned because
  # GNU date run as root opens any file named by TZ= in the date string.
  && echo 'node ALL=(root) NOPASSWD: /usr/bin/date "", /usr/bin/date ^-u -s [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$' \
    > /etc/sudoers.d/set-system-time \
  && chmod 0440 /etc/sudoers.d/set-system-time \
  && visudo -cf /etc/sudoers.d/set-system-time

RUN curl -fsSL https://deb.nodesource.com/setup_$NODE | bash - \
  && apt-get -y install --no-install-recommends nodejs \
  && npm config rm proxy \
  && npm config rm https-proxy \
  && npm config set fetch-retries 5 \
  && npm config set fetch-retry-mintimeout 60000 \
  && npm config set fetch-retry-maxtimeout 120000 \
  && npm cache clean -f \
  && npm install npm@latest -g \
  && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*
